# Copy to .env and fill in the values. Read by the API (godotenv) and by the
# Makefile. Defaults match the services in the root docker-compose.yml.
# Keep comments on their own lines (inline comments break `make`).

# --- Required -------------------------------------------------------------
# https://openweathermap.org/api
export OPEN_WEATHER_API_KEY=
# The server refuses to start without Mailtrap credentials.
export MAILTRAP_USERNAME=
export MAILTRAP_PASSWORD=

# --- Server ---------------------------------------------------------------
export ADDR=:8080
# "production" switches Mailtrap from the sandbox to live sending.
export ENV=development
# Host shown in Swagger.
export EXTERNAL_URL=localhost:8080
# Base URL used for email activation links.
export FRONTEND_URL=http://localhost:5173

# --- PostgreSQL -----------------------------------------------------------
export DB_ADDR=postgres://admin:adminpassword@localhost/weather?sslmode=disable
export DB_MAX_OPEN_CONNS=30
export DB_MAX_IDLE_CONNS=30
export DB_MAX_IDLE_TIME=15m

# --- Redis cache ----------------------------------------------------------
export REDIS_ENABLED=true
export REDIS_ADDR=localhost:6379
export REDIS_PW=
export REDIS_DB=0

# --- Auth -----------------------------------------------------------------
# CHANGE IN PRODUCTION.
export AUTH_TOKEN_SECRET=change-me
# Basic-auth credentials protecting /v1/debug/vars.
export AUTH_BASIC_USER=admin
export AUTH_BASIC_PASS=admin

# --- Misc -----------------------------------------------------------------
export FROM_EMAIL=from@example.com
export RATE_LIMITER_ENABLED=true
# Requests allowed per client IP per 5 seconds.
export RATELIMITER_REQUESTS_COUNT=20
# OpenTelemetry OTLP/HTTP endpoint (Jaeger).
export JAEGER_ADDR=localhost:4318
